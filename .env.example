# Local example only; replace the placeholder in BOTH values. Never commit .env.
POSTGRES_PASSWORD=replace-with-a-strong-local-password
DATABASE_URL=postgresql://relay:replace-with-a-strong-local-password@127.0.0.1:5432/relay_crm
# Enable sample data only for a demo database; leave disabled for imported/real data.
SEED_DEMO=0
PORT=3000
# Owner email is used for first-time production provisioning from the hosting shell.
OWNER_EMAIL=
# Resend API key and a sender on a verified Resend domain.
RESEND_API_KEY=
RECOVERY_FROM_EMAIL=
# Optional one-time owner reset from the dashboard, paired with OWNER_EMAIL.
OWNER_ACCESS_CODE=
# Meta signed inbound-text webhook. Use a random private verification token.
META_APP_SECRET=
META_VERIFY_TOKEN=
# Opt-in AI analysis and automatic chat replies.
AI_CHAT_ENABLED=0
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
# Set to the supported version used by your Meta app, such as v23.0.
META_GRAPH_VERSION=
META_WHATSAPP_ACCESS_TOKEN=
META_INSTAGRAM_ACCESS_TOKEN=
META_MESSENGER_ACCESS_TOKEN=
# Enable store creation after applying this version and checking database privileges.
STOREFRONT_SIGNUP_ENABLED=0
# Hosting admin mapping. Key: channel plus Meta Page, Instagram, or phone-number ID.
# STORE_META_ROUTES={"Messenger:123456":{"store":"example-store","token":"..."}}
